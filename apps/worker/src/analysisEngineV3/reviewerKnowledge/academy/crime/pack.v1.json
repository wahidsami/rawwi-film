    "required_evidence": [
      "Speaker identity or reporting source.",
      "Target or victim identity where relevant.",
      "Scene or narrative context.",
      "Literal wording, implied wording, or reported event linkage."
    ],
    "insufficient_evidence": [
      "A single suspicious word without context.",
      "A neutral news or documentary reference.",
      "A false accusation or denial without supporting evidence."
    ],
    "reviewer_heuristics": [
      "Read the whole scene before deciding whether the content is crime or just crime-adjacent.",
      "Separate planning, execution, reporting, and false accusation into different reasoning outcomes.",
      "Use cross-sentence and cross-scene evidence to distinguish suspicion from proof.",
      "Treat police, court, and documentary material as context, not automatic violations.",
      "Prefer the narrowest concept that the evidence actually supports."
    ],
    "legal_exceptions": [
      "Educational",
      "Historical",
      "Documentary",
