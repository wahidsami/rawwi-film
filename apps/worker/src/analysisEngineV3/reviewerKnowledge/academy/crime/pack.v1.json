      "Police investigation",
      "Court case",
      "Confession",
      "Witness testimony",
      "False accusation",
      "Condemnation",
      "Dream",
      "Flashback",
      "Observation"
    ],
    "positive_examples": [
      "A character openly plans a robbery.",
      "A character confesses to fraud.",
      "A scene shows organized crime coordinating money laundering."
    ],
    "negative_examples": [
      "A news report describing an arrest.",
      "A documentary discussing past criminal activity.",
      "A police interview repeating a suspect's words as evidence."
    ],
    "common_false_positives": [
      "Neutral reporting mistaken for endorsement.",
      "Historical narration mistaken for present criminal conduct.",
      "Police or court language mistaken for the speaker's own criminal intent.",
      "False accusation mistaken for proved crime."
    ],
