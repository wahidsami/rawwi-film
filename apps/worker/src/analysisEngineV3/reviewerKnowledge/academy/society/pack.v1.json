    "required_evidence": [
      "A literal span showing the social behavior, insult, discrimination, exclusion, or support inside the chunk.",
      "Speaker identity, target identity, and relationship cues that explain who is affected.",
      "Context clues that distinguish discussion, criticism, satire, education, or news from endorsement.",
      "Cross-sentence or cross-scene support when the harmful or supportive meaning is only revealed later."
    ],
    "insufficient_evidence": [
      "A neutral mention of family, school, workplace, or community with no harmful or supportive social meaning.",
      "A documentary, court, or news report that records the social issue without endorsing it.",
      "A quotation, flashback, dream, or fictional scene that is clearly framed as non-endorsing.",
      "A single ambiguous word without speaker, target, or relationship support."
    ],
    "reviewer_heuristics": [
      "Do not collapse all social talk into one concept; identify the exact social issue first.",
      "Separate discussion from criticism, satire, condemnation, promotion, encouragement, education, historical narration, documentary, news, fiction, dream, flashback, and quotation.",
      "Check whether the text targets a protected person, a family role, a workplace role, or the public at large.",
      "Use social context to distinguish rudeness from bullying, exclusion, discrimination, or abuse.",
      "Treat social media posts, rumors, and public panic as context-sensitive reasoning rather than automatic violations.",
      "Use the strongest literal span that supports the reviewer conclusion."
    ],
    "legal_exceptions": [
      "Discussion",
      "Criticism",
      "Satire",
      "Condemnation",
      "Promotion",
      "Encouragement",
      "Education",
      "Historical narration",
      "Documentary",
      "News",
      "Fiction",
      "Dream",
      "Flashback",
      "Quotation"
    ],
    "positive_examples": [
      "Direct bullying of a student in class.",
      "Public humiliation of a disabled person.",
      "Racist or tribal language attacking a family or community.",
      "A social media post spreading rumor and panic about a neighbor.",
      "Abuse of authority against a worker or citizen.",
      "A direct insult that clearly targets a protected person.",
      "Domestic abuse framed as a harmful event in the scene."
    ],
    "negative_examples": [
      "A teacher calmly explaining why bullying is wrong.",
      "A documentary about family breakdown without endorsement.",
      "A court transcript repeating insult language as evidence.",
      "A news report describing social unrest without celebrating it.",
      "A fictional villain line that the story clearly condemns.",
      "A scene description of family tension that does not itself insult anyone.",
      "A neutral discussion of cultural identity in class."
    ],
    "common_false_positives": [
      "Criticism mistaken for hate or discrimination.",
      "Family discipline mistaken for abuse without harm or humiliation.",
      "A quotation or documentary mention mistaken for endorsement.",
      "A workplace or school instruction mistaken for public shaming.",
      "A social media rumor mistaken for a confirmed finding.",
      "A scene of support or caregiving mistaken for a negative social issue."
    ],
