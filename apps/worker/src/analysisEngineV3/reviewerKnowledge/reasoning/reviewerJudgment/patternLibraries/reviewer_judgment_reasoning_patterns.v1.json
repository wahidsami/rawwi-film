      "id": "judgment_pattern_competing_interpretations",
      "title": "Competing Interpretations",
      "description": "Compare two plausible readings before choosing one.",
      "primary_concept_id": "competing_interpretations",
      "related_concept_ids": [
        "evidence_sufficiency",
        "confidence_calibration"
      ],
      "direct_expressions": [
        "Two readings are plausible.",
        "The scene can mean more than one thing."
      ],
      "indirect_expressions": [
        "The next sentence resolves the ambiguity.",
        "Later context favors one reading."
      ],
      "semantic_intent": [
        "compare",
        "weigh",
        "resolve",
        "calibrate"
      ],
      "supporting_evidence": [
        "multiple plausible cues",
        "contextual reversal",
        "speaker and target alignment"
      ],
      "contradictory_evidence": [
        "a clue points to another meaning",
        "the exception changes the reading"
      ],
      "false_positives": [
        "choosing the first plausible reading",
        "treating uncertainty as certainty"
      ],
      "counter_examples": [
        "A reviewer keeps two interpretations open until later context resolves them."
