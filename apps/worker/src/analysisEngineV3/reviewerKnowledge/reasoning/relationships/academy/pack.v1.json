    "required_evidence": [
      "Speaker identity",
      "Target identity",
      "Relationship role",
      "Scene or dialogue context"
    ],
    "insufficient_evidence": [
      "A single isolated command without role context.",
      "Guessing corruption from a release phrase alone.",
      "Assuming violence without evidence."
    ],
    "reviewer_heuristics": [
      "Read the relationship before judging the sentence.",
      "The same sentence can mean command, care, sarcasm, or discretion depending on the speaker.",
      "Do not classify relationships themselves as violations.",
      "Lower confidence when the role frame is missing."
    ],
    "legal_exceptions": [
      "Procedural release",
      "Lawful discretion",
      "Family discipline",
      "Casual peer dismissal",
      "Quotation",
      "Narration",
      "Documentary",
      "Educational",
      "Historical"
    ],
    "positive_examples": [
      "A police commander telling a suspect to leave.",
      "A judge using lawful discretion to release someone.",
      "A father protecting a child with a short command."
    ],
    "negative_examples": [
      "Treating a quoted command as the speaker’s own intent without support.",
      "Assuming bribery from a release phrase without context.",
      "Treating every sentence as a violation regardless of relationship."
    ],
    "common_false_positives": [
      "Lawful discretion mistaken for corruption.",
      "Family protection mistaken for abuse.",
      "Peer dismissal mistaken for criminal intent."
    ],
