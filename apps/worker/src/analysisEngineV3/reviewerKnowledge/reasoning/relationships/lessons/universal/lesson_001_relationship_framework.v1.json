  "reviewerPrinciples": [
    "The same sentence can mean different things for different relationships.",
    "Relationships influence reasoning and confidence, not violations by themselves.",
    "Authority, family, friendship, and formal roles all matter.",
    "Quote, narration, and scene context can neutralize an apparent command."
  ],
  "reviewerMethodology": [
    "Identify the speaker and target.",
    "Identify the relationship type.",
    "Check the scene for authority, trust, or dependence.",
    "Check if later lines reverse the first impression.",
    "Apply confidence based on corroboration."
  ],
  "reasoningProcess": [
    "Start from the relationship frame.",
    "Compare the same sentence across roles.",
    "Look for procedural, protective, corrupt, or casual meaning.",
    "Require evidence before escalation."
  ],
  "evidenceRules": {
    "minimum": [
      "Speaker role and target role must be visible in the scene."
    ],
    "strong": [
      "Relationship is explicit and the scene reinforces the reading.",
      "Later dialogue confirms the meaning."
    ],
    "weak": [
      "A bare sentence without role context.",
      "A command with no follow-up."
    ],
    "insufficient": [
      "Guessing from the phrase alone.",
      "Assuming corruption without evidence."
    ],
    "confidenceGuidance": [
      "95: clear and corroborated",
      "80: supported by relationship context",
      "60: plausible but ambiguous",
      "40: weak and uncertain",
      "0: unsupported"
    ]
  },
  "contextRules": [
    "Use neighboring sentences before finalizing.",
    "Treat narrated or quoted speech differently from direct speech.",
    "A later correction can change the reading entirely."
  ],
  "sceneLevelReasoning": [
    "Evaluate the whole exchange, not a single word.",
    "Scene purpose can change the meaning of the same phrase."
  ],
  "characterRelationshipAnalysis": [
    "Authority relations can turn a command into procedure.",
    "Family relations can turn harsh words into discipline or protection.",
    "Peer relations can turn a command into casual dismissal."
  ],
  "crossSentenceReasoning": [
    "Later lines can clarify whether the phrase is malicious, lawful, or casual.",
    "The phrase alone is not enough."
  ],
  "crossSceneReasoning": [
    "Earlier scenes may establish lawful or corrupt behavior.",
    "Later scenes can reverse the apparent meaning."
  ],
  "confidenceRules": [
    "One sentence alone is usually low confidence.",
    "Multiple supporting sentences raise confidence.",
    "Dialogue plus action is stronger than dialogue alone.",
    "Relationship and role context can lower or raise confidence."
  ],
  "falsePositives": [
    "Assuming bribery from a release phrase without context.",
    "Assuming violence from a command without role evidence.",
    "Assuming corruption when lawful discretion is possible."
  ],
  "exceptions": [
    "Quotation",
    "Narration",
    "Documentary",
    "Educational",
    "Historical",
    "Court testimony",
    "Police procedure",
    "Family discipline",
    "Professional discretion",
    "Joking or casual peer dismissal",
    "Later clarification"
  ],
