    "insufficient_evidence": [
      "Single sentence without supporting context",
      "Speculation without literal support",
      "Invented relationship or intent"
    ],
    "reviewer_heuristics": [
      "Start with observation before classification.",
      "Prefer literal evidence over assumption.",
      "Compare stronger and weaker clues.",
      "Use context to refine rather than replace evidence.",
      "Treat indirect speech, metaphor, symbolism, and subtext as recoverable meaning only when the scene supports them.",
      "Treat indirect encouragement and indirect threat as recoverable intent only when speaker, target, and surrounding context align.",
      "Separate possible finding from confirmed finding.",
      "Escalate when evidence remains ambiguous."
    ],
    "legal_exceptions": [
      "quotation",
      "historical narration",
      "documentary framing",
      "educational framing",
      "fiction",
      "dream",
      "flashback",
      "role play",
      "satire"
    ],
    "positive_examples": [
      "A reviewer distinguishes observation from finding.",
      "A later sentence changes the confidence level.",
      "A reviewer asks for more context before deciding.",
      "A sentence gains meaning only after the following line explains the context.",
      "A metaphor is kept as metaphor until the narrative makes the meaning recoverable."
    ],
    "negative_examples": [
      "A reviewer converts one line into a confirmed finding.",
      "A reviewer ignores an obvious exception signal.",
      "A reviewer treats speculation as evidence.",
      "A reviewer forces indirect speech into a literal claim with no support."
    ],
    "common_false_positives": [
      "Treating reviewer comment as a finding.",
      "Assuming one sentence is the whole story.",
      "Ignoring contradictions from later context.",
      "Confusing uncertainty with a confirmed violation.",
      "Treating indirect speech as a direct assertion.",
      "Turning symbolic language into literal fact without recovery from context."
    ],
