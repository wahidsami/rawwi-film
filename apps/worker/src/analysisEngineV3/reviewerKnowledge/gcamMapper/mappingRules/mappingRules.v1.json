{
  "schema_version": 1,
  "version": "1.0.0",
  "id": "gcam_mapper_mapping_rules",
  "title": "GCAM Mapping Rules",
  "description": "Deterministic matching rules used to map reviewer judgment to GCAM reporting artifacts.",
  "entries": [
    {
      "id": "rule.security.overthrow",
      "version": "1.0.0",
      "title": "Security overthrow rule",
      "description": "Match direct or indirect security overthrow signals.",
      "priority": 100,
      "match": {
        "concepts": ["security", "state_security", "national_security", "terrorism", "extremism", "overthrow", "coup"],
        "domains": ["security", "politics"],
        "targets": ["state", "government", "military", "public_official"],
        "actions": ["incitement", "threat", "glorification", "instruction"],
        "intents": ["promotion", "encouragement", "glorification", "instruction"],
        "contexts": ["dialogue", "narration", "news", "historical", "documentary", "educational"]
      },
      "articleMappingId": "article.security.overthrow",
      "atomMappingId": "atom.security.overthrow.explicit",
      "relatedRuleIds": ["rule.security.public_order"],
      "debtNote": "If the source is not official GCAM material, record mapping debt rather than guessing."
    },
    {
      "id": "rule.security.public_order",
      "version": "1.0.0",
      "title": "Security public order rule",
      "description": "Match public disorder and riot escalation.",
      "priority": 90,
      "match": {
        "concepts": ["public_order", "riot", "civil_unrest", "mass_panic"],
        "domains": ["security", "society"],
        "targets": ["public", "state"],
        "actions": ["incitement", "escalation", "normalization"],
        "intents": ["promotion", "encouragement", "instruction"],
        "contexts": ["dialogue", "narration", "news", "historical"]
      },
      "articleMappingId": "article.security.public_order",
      "atomMappingId": "atom.society.dignity",
      "relatedRuleIds": [],
      "debtNote": "Use the public order article only when a more specific security rule is not a better fit."
    },
    {
