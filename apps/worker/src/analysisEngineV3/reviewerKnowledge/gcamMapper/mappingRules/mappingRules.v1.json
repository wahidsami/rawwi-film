      "version": "1.0.0",
      "title": "Security banned groups rule",
      "description": "Match extremist ideology, recruitment, and support for banned groups.",
      "priority": 96,
      "match": {
        "concepts": ["terrorism", "extremism", "recruitment", "banned_group", "violent_ideology", "radicalization"],
        "domains": ["security", "politics"],
        "targets": ["group", "audience", "youth", "state", "government", "military"],
        "actions": ["recruitment", "promotion", "support", "glorification", "instruction"],
        "intents": ["promotion", "encouragement", "glorification", "instruction"],
        "contexts": ["dialogue", "narration", "news", "historical", "documentary", "educational", "fiction"]
      },
      "articleMappingId": "article.security.banned_groups",
      "atomMappingId": "atom.security.banned_groups.recruitment",
      "relatedRuleIds": ["rule.security.overthrow"],
      "debtNote": "Use when the security harm is recruitment into an extremist or banned group."
    },
    {
