      "version": "1.0.0",
      "title": "Security military disclosure rule",
      "description": "Match disclosure or leaking of protected military or secret information.",
      "priority": 97,
      "match": {
        "concepts": ["military_disclosure", "confidential_information", "classified_information", "secret_information"],
        "domains": ["security", "politics"],
        "targets": ["military", "state", "government", "official", "information"],
        "actions": ["disclosure", "leak", "reveal", "expose"],
        "intents": ["promotion", "encouragement", "instruction", "neutral"],
        "contexts": ["dialogue", "narration", "news", "historical", "documentary", "educational", "court", "police_investigation"]
