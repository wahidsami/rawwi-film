    "reviewerQuestions": [
      {
        "id": "crime_question_narrative",
        "purpose": "Narrative question",
        "expectedAnswerFormat": "What is happening in the scene?",
        "reasoningGuidance": "Describe the scene first.",
        "evidenceRequirements": [
          "Scene text",
          "Story memory"
        ]
      },
      {
        "id": "crime_question_speaker",
        "purpose": "Speaker question",
        "expectedAnswerFormat": "Who is speaking?",
        "reasoningGuidance": "Determine the source of the statement.",
        "evidenceRequirements": [
          "Dialogue or narration"
        ]
      },
      {
        "id": "crime_question_target",
        "purpose": "Target question",
        "expectedAnswerFormat": "Who or what is targeted?",
        "reasoningGuidance": "Identify the target before judging.",
        "evidenceRequirements": [
          "Literal target evidence"
        ]
      },
      {
        "id": "crime_question_intent",
        "purpose": "Intent question",
        "expectedAnswerFormat": "What is the speaker trying to do?",
        "reasoningGuidance": "Assess intent from context.",
        "evidenceRequirements": [
          "Intent cues"
        ]
      },
      {
        "id": "crime_question_context",
        "purpose": "Context question",
        "expectedAnswerFormat": "Does the surrounding context change the meaning?",
        "reasoningGuidance": "Check later dialogue and scene framing.",
        "evidenceRequirements": [
          "Neighbouring sentences",
          "Scene memory"
        ]
      },
      {
        "id": "crime_question_evidence",
        "purpose": "Evidence question",
        "expectedAnswerFormat": "What exact evidence supports the conclusion?",
        "reasoningGuidance": "Use the narrowest reliable span.",
        "evidenceRequirements": [
          "Literal evidence"
        ]
      },
      {
        "id": "crime_question_confidence",
        "purpose": "Confidence question",
        "expectedAnswerFormat": "How certain is the conclusion?",
        "reasoningGuidance": "Calibrate confidence to evidence strength.",
        "evidenceRequirements": [
          "Supporting and contradicting evidence"
        ]
      },
      {
        "id": "crime_question_exception",
        "purpose": "Exception question",
        "expectedAnswerFormat": "Is there a documentary, educational, police, or court exception?",
        "reasoningGuidance": "Check exclusions before finalizing.",
        "evidenceRequirements": [
          "Exception signals"
        ]
      },
      {
        "id": "crime_question_cross",
        "purpose": "Cross-scene question",
        "expectedAnswerFormat": "Do later scenes confirm or reverse the meaning?",
        "reasoningGuidance": "Use the full story if available.",
        "evidenceRequirements": [
          "Later dialogue",
          "Later narration"
        ]
      },
      {
        "id": "crime_question_false_positive",
        "purpose": "False positive question",
        "expectedAnswerFormat": "Could this be a harmless mention or a false accusation?",
        "reasoningGuidance": "Do not overclassify ambiguous material.",
        "evidenceRequirements": [
          "Denials",
          "Corrections"
        ]
      }
    ],
    "examples": [
      "خطة السرقة الليلة واضحة.",
      "الجريدة ذكرت الجريمة في تقريرها.",
      "المشهد يشرح كيف يهرب الجاني من الشرطة."
    ],
    "counterExamples": [
      "الوثائقي يشرح جريمة قديمة بوصفها حدثًا تاريخيًا.",
      "الشرطي يقرأ أقوال المتهم داخل المحضر.",
      "المشهد يذكر كلمة جريمة دون أي فعل أو نية."
    ],
    "exceptions": [
      "Educational discussion.",
      "Documentary narration.",
      "Historical narration.",
      "Police investigation.",
      "Court case.",
      "Confession.",
      "Witness testimony.",
      "False accusation.",
      "Dream sequence.",
      "Flashback."
    ],
    "evidenceRules": {
      "minimum": [
        "An exact crime-related span inside the screenplay.",
        "A speaker, narrator, or reporting source."
      ],
      "strong": [
        "Explicit criminal act plus clear target or victim.",
        "Dialogue plus scene action plus later confirmation.",
        "Planning language plus execution or concealment language."
      ],
      "weak": [
        "A single suspicious word without context.",
        "An implied crime without corroboration.",
        "A report or quotation that might not be endorsed."
      ],
      "insufficient": [
        "Assumption without scene evidence.",
        "A neutral historical or documentary reference.",
        "A false accusation without independent proof."
      ],
      "confidenceGuidance": [
        "100: Explicit crime with strong corroboration.",
        "85: Strong evidence and stable context.",
        "65: Evidence exists but needs caution.",
        "40: Weak or partial support.",
        "0: No reliable crime finding."
      ]
    },
