  "lesson": {
    "id": "lesson_001_crime_framework",
    "title": "Crime Reviewer Framework",
    "version": {
      "major": 1,
      "minor": 0,
      "patch": 0
    },
    "language": "en",
    "summary": "Teach the reviewer to distinguish crime reference, planning, execution, reporting, exceptions, and false accusations across dialogue, narration, scene description, and cross-scene context.",
    "learningObjectives": [
      "Distinguish a crime reference from a crime finding.",
      "Distinguish planning, attempt, execution, concealment, and reporting.",
      "Recognize documentary, historical, police, and court exceptions.",
      "Use speaker identity, target identity, and context to calibrate confidence.",
      "Avoid collapsing all crime-related material into one concept."
    ],
