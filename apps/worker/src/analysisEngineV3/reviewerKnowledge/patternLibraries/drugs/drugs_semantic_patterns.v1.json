  "entries": [
    {
      "id": "pattern_direct_consumption",
      "title": "Direct Consumption",
      "description": "Direct consumption versus reference, medical use, or depiction.",
      "primary_concept_id": "drug_consumption",
      "related_concept_ids": [
        "drug_possession",
        "drug_implied_use",
        "drug_dialogue"
      ],
      "direct_expressions": [
        "يأخذ الحبة",
        "يبتلعها",
        "يدخنها"
      ],
      "indirect_expressions": [
        "الرائحة غريبة",
        "يتماسك بصعوبة"
      ],
      "semantic_intent": [
        "consumption",
        "reference",
        "implied use"
      ],
      "supporting_evidence": [
        "direct action",
        "scene cue"
      ],
      "contradictory_evidence": [
        "doctor's orders",
        "educational warning"
      ],
      "false_positives": [
        "medical use",
        "harmless reference"
      ],
      "counter_examples": [
        "prescription medication",
        "news report about drugs"
      ],
      "cross_sentence_indicators": [
        "later line confirms use",
        "another line says it is medicine"
      ],
      "scene_indicators": [
        "bathroom",
        "party",
        "street corner"
      ],
      "reviewer_guidance": [
        "Check whether the substance is illicit or prescribed.",
        "Do not confuse smell or props with use."
      ],
      "confidence_modifiers": [
        {
          "id": "consumption_direct",
          "title": "Direct action",
          "description": "The scene shows an actual act of use.",
          "confidence": 90
        },
        {
          "id": "consumption_contextual",
          "title": "Contextual",
          "description": "The scene only implies use.",
          "confidence": 65
        }
      ],
      "glossary_relationships": [
        {
          "id": "consumption_rel_1",
