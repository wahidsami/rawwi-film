  "entries": [
    {
      "id": "religion_pattern_direct_insult",
      "title": "Direct Religious Insult",
      "description": "Direct insult or slur toward the religion or its prophets.",
      "primary_concept_id": "religion_religious_hate_speech",
      "related_concept_ids": [
        "religion_islamic_religion",
        "religion_prophets",
        "religion_holy_books"
      ],
      "direct_expressions": [
        "إهانة النبي",
        "سبّ القرآن"
      ],
      "indirect_expressions": [
        "التقليل من قيمة المقدسات",
        "السخرية من الدين"
      ],
      "semantic_intent": [
        "attack",
        "mock"
      ],
      "supporting_evidence": [
        "explicit insult to a prophet",
        "hostile framing toward a holy book"
      ],
      "contradictory_evidence": [
        "explicit condemnation",
        "clearly educational framing"
      ],
      "false_positives": [
        "court transcript",
        "news report",
        "academic citation"
      ],
      "counter_examples": [
        "teacher explaining why insult is harmful"
      ],
      "cross_sentence_indicators": [
        "later line repeats the slur",
        "another speaker endorses the insult"
      ],
      "scene_indicators": [
        "dialogue attack",
        "hostile exchange"
      ],
      "reviewer_guidance": [
        "Anchor on the exact insult and do not overgeneralize."
      ],
      "confidence_modifiers": [
        {
          "id": "religion_pattern_direct_insult_high",
          "title": "High",
          "description": "Direct insult with explicit target.",
          "confidence": 95
        },
        {
          "id": "religion_pattern_direct_insult_medium",
          "title": "Medium",
          "description": "Target is explicit but the wording is shorter.",
          "confidence": 75
        }
      ],
      "glossary_relationships": [
