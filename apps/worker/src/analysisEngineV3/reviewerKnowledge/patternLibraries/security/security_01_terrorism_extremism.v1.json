      "id": "security_pattern_terrorism_glorification",
      "title": "Terrorism Glorification",
      "description": "Praise, support, or normalization of terrorism and extremist violence.",
      "primary_concept_id": "terrorism",
      "related_concept_ids": [
        "extremism",
        "violence"
      ],
      "direct_expressions": [
        "الإرهاب هو الحل",
        "عاش الإرهاب",
        "تحيا الجماعة الإرهابية"
      ],
      "indirect_expressions": [
        "العمل البطولي",
        "الرد القوي",
        "هذا طريق الشرف"
      ],
      "semantic_intent": [
        "promotion of terrorism",
        "extremist glorification"
      ],
      "supporting_evidence": [
        "Positive framing of extremist violence.",
        "Explicit approval language."
      ],
      "contradictory_evidence": [
        "Explicit condemnation.",
        "Documentary or news reporting frame."
      ],
      "false_positives": [
        "A news report repeating the phrase as evidence.",
        "A fictional villain line that the story rejects."
      ],
      "counter_examples": [
        "A journalist describing terrorism as a crime.",
        "A classroom discussion of extremist rhetoric."
      ],
      "cross_sentence_indicators": [
        "A neutral sentence is followed by praise for violent action."
      ],
      "scene_indicators": [
        "dialogue",
        "crowd chant",
        "recruitment scene"
      ],
      "reviewer_guidance": [
        "Anchor the finding to the literal praise phrase.",
        "Check whether the text frames the act as admirable or justified."
      ],
      "confidence_modifiers": [
        {
          "id": "modifier_direct_praise",
          "title": "Direct Praise",
          "description": "Explicit praise for terrorism or extremism.",
          "confidence": 96
        },
        {
          "id": "modifier_coded_sympathy",
          "title": "Coded Sympathy",
          "description": "Indirect sympathy or coded praise.",
          "confidence": 72
        }
      ],
