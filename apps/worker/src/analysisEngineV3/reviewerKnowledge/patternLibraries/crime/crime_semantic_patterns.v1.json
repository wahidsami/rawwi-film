    {
      "id": "pattern_implicit_crime",
      "title": "Implicit Crime",
      "description": "Indirect wording that still points to crime when the local context clarifies the meaning.",
      "primary_concept_id": "crime_reference",
      "related_concept_ids": [
        "crime_planning",
        "crime_conspiracy",
        "crime_reported_event",
        "crime_scene_description"
      ],
      "direct_expressions": [
        "coded plan",
        "secret deal"
      ],
      "indirect_expressions": [
        "this job",
        "same old work"
      ],
      "semantic_intent": [
        "implication",
        "coded reference",
        "narrative clue"
      ],
      "supporting_evidence": [
        "speaker secrecy",
        "later confirmation"
      ],
      "contradictory_evidence": [
        "medical context",
        "explicit denial"
      ],
      "false_positives": [
        "ordinary business talk mistaken for crime"
      ],
      "counter_examples": [
        "simple work discussion"
      ],
      "cross_sentence_indicators": [
        "later line reveals the plan",
        "another line confirms the crime"
      ],
      "scene_indicators": [
        "hushed dialogue",
        "hidden note"
      ],
      "reviewer_guidance": [
        "Read for implication, not keywords."
      ],
      "confidence_modifiers": [
        {
          "id": "pattern_implicit_crime_confidence",
          "title": "Implicit Crime confidence",
          "description": "Confidence modifier for implicit crime.",
          "confidence": 78
        }
      ],
